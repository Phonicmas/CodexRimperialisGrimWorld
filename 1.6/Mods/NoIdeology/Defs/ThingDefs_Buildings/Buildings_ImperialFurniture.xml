<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="Bed">
        <defName>BEWH_ImperialBed</defName>
        <label>common single bed</label>
        <description>A simple Imperial bed. A common sight on any world of the Imperium of Man, for even the most devoted require rest. \n\nManpower was, is, and will always be the greatest strength of the Imperium of Man.</description>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <defaultPlacingRot>South</defaultPlacingRot>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Bed/CommonBedSingle/Bed_CommonSingle</texPath>
        </graphicData>
        <researchPrerequisites Inherit="False">
            <li>BEWH_ImperialFurnishings</li>
        </researchPrerequisites>
    </ThingDef>
    <ThingDef ParentName="DoubleBed">
        <defName>BEWH_ImperialDoubleBed</defName>
        <label>common double bed</label>
        <description>A simple Imperial bed for two. A common sight on any world of the Imperium of Man, for even the most devoted require rest. \n\nManpower was, is, and will always be the greatest strength of the Imperium of Man.</description>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <defaultPlacingRot>South</defaultPlacingRot>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Bed/CommonBedDouble/Bed_CommonDouble</texPath>
        </graphicData>
        <researchPrerequisites Inherit="False">
            <li>BEWH_ImperialFurnishings</li>
        </researchPrerequisites>
    </ThingDef>
    <ThingDef ParentName="DoubleBed">
        <defName>BEWH_ImperialNobleDoubleBed</defName>
        <label>Noble double bed</label>
        <description>An ornate bed for two, suitable for the highborn of the Imperium of Man - the nobility. \n\nThe highborn live a life entirely different to that of common Imperial citizens - a life of immense wealth, power, and influence. That is not to say it is without its own dangers - shunning by their peers, assassins in the night, and the temptations of the Chaos Gods in the form of cults and cliques.</description>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <defaultPlacingRot>South</defaultPlacingRot>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Bed/RoyalBedDouble/Bed_RoyalDouble</texPath>
            <drawSize>(4.05,4.05)</drawSize>
        </graphicData>
        <statBases>
            <MaxHitPoints>200</MaxHitPoints>
            <WorkToBuild>50000</WorkToBuild>
            <Mass>60</Mass>
            <Beauty>75</Beauty>
            <BedRestEffectiveness>1.05</BedRestEffectiveness>
            <Comfort>0.90</Comfort>
        </statBases>
        <costList>
            <Gold>50</Gold>
        </costList>
        <thingSetMakerTags>
            <li>RewardStandardQualitySuper</li>
        </thingSetMakerTags>
        <researchPrerequisites Inherit="False">
            <li>BEWH_GildedHalls</li>
        </researchPrerequisites>
        <costStuffCount>100</costStuffCount>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    </ThingDef>
    <ThingDef ParentName="BedWithQualityBase">
        <defName>BEWH_MedicaeBed</defName>
        <label>medicae bed</label>
        <description>A medical bed, moderately equipped with medical paraphernalia for use by a trained medicae. Patients resting on it can look forward to improved medical outcomes. \n\nThose resting on this bed should consider themselves lucky. On some worlds of the Imperium, a man with an infected wound can only look forward to a crude amputation with a dirty bonesaw - and, probably, a slow death.</description>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <defaultPlacingRot>South</defaultPlacingRot>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Bed/Medicae/Bed_Medical</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <castEdgeShadows>True</castEdgeShadows>
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <WorkToBuild>2800</WorkToBuild>
            <Mass>35</Mass>
            <Flammability>1.0</Flammability>
            <BedRestEffectiveness>1</BedRestEffectiveness>
            <Comfort>0.80</Comfort>
            <ImmunityGainSpeedFactor>1.11</ImmunityGainSpeedFactor>
            <MedicalTendQualityOffset>0.1</MedicalTendQualityOffset>
            <SurgerySuccessChanceFactor>1.1</SurgerySuccessChanceFactor>
            <BirthRitualQualityOffset MayRequire="Ludeon.RimWorld.Biotech">5</BirthRitualQualityOffset>
        </statBases>
        <size>(1,2)</size>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>40</costStuffCount>
        <costList>
            <Steel>80</Steel>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        <comps>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>VitalsMonitor</li>
                    <li>EndTable</li>
                    <li>Dresser</li>
                    <li MayRequire="Ludeon.RimWorld.Ideology">SleepAccelerator</li>
                </linkableFacilities>
            </li>
        </comps>
        <building>
            <bed_showSleeperBody>False</bed_showSleeperBody>
            <bed_healPerDay>10</bed_healPerDay>
            <bed_defaultMedical>true</bed_defaultMedical>
            <buildingSizeCategory>Small</buildingSizeCategory>
            <paintable>true</paintable>
        </building>
        <fillPercent>0.4</fillPercent>
        <pathCost>42</pathCost>
        <staticSunShadowHeight>0.17</staticSunShadowHeight>
        <researchPrerequisites Inherit="False">
            <li>BEWH_MechanicusApparatus</li>
        </researchPrerequisites>
    </ThingDef>
    <ThingDef ParentName="TableGatherSpotBase">
        <defName>BEWH_ImperialTableShort</defName>
        <label>table (2x1)</label>
        <description>A simple Imperial table. Consider yourself lucky to have one, as many in the Imperium do not. \n\nEven the simple meals of the rimworlds would be considered high-class food. Lower-class Imperial citizens live on bacterial gruel, flavored algal carboslime, and the ever-present corpse-starch.</description>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Table/Common/TableCommon1x2</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(3.15,4.15)</drawSize>
            <drawOffset>(0,0,0.1)</drawOffset>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <uiIconScale>0.8</uiIconScale>
        <statBases>
            <MaxHitPoints>75</MaxHitPoints>
            <WorkToBuild>750</WorkToBuild>
            <Mass>5</Mass>
            <Flammability>1.0</Flammability>
            <Beauty>0.5</Beauty>
        </statBases>
        <size>(1,2)</size>
        <costStuffCount>28</costStuffCount>
        <researchPrerequisites Inherit="False">
            <li>BEWH_ImperialFurnishings</li>
        </researchPrerequisites>
    </ThingDef>

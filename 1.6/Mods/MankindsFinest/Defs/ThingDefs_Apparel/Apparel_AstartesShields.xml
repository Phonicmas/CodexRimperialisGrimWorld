<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ApparelMakeableBase">
        <defName>BEWH_AstartesCombatShield</defName>
        <label>combat shield</label>
        <description>A lighter cousin of the storm shield, strapped to the forearm so that the bearer keeps a hand free for a pistol or blade. While not as protective as a full storm shield, the power field sheathing its face turns aside blows and bolts that would otherwise find their mark. \n\nCombat shields are favoured by Assault Marines and Vanguard Veterans, who must cross open ground under fire before they can bring their chainswords to bear.</description>
        <techLevel>Spacer</techLevel>
        <graphicData>
            <texPath>Things/Shields/Astartes/CombatShieldA/CombatShieldA</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>BEWH_CutoutThreeColor</shaderType>
        </graphicData>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <skillRequirements>
                <Crafting>10</Crafting>
            </skillRequirements>
            <recipeUsers Inherit="false">
                <li>FabricationBench</li>
            </recipeUsers>
            <researchPrerequisites Inherit="False">
                <li>BEWH_PowerArmorMkVII</li>
            </researchPrerequisites>
        </recipeMaker>
        <statBases>
            <MaxHitPoints>800</MaxHitPoints>
            <Mass>3.5</Mass>
            <Flammability>0</Flammability>
            <WorkToMake>30000</WorkToMake>
            <MarketValue>1600</MarketValue>
            <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <ArmorRating_Heat>0.3</ArmorRating_Heat>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>-0.05</MoveSpeed>
            <ShootingAccuracyPawn>-1</ShootingAccuracyPawn>
        </equippedStatOffsets>
        <costList>
            <Plasteel>60</Plasteel>
            <Uranium>10</Uranium>
            <ComponentSpacer>1</ComponentSpacer>
        </costList>
        <thingCategories>
            <li>ApparelArmor</li>
        </thingCategories>
        <thingSetMakerTags Inherit="False"/>
        <smeltable>false</smeltable>
        <tradeability>Sellable</tradeability>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <careIfWornByCorpse>false</careIfWornByCorpse>
            <useDeflectMetalEffect>true</useDeflectMetalEffect>
            <bodyPartGroups>
                <li>Arms</li>
            </bodyPartGroups>
            <layers>
                <li>BEWH_Shield</li>
            </layers>
            <tags>
                <li>BEWH_AstartesCombatShield</li>
            </tags>
            <renderNodeProperties>
                <li Class="Core40k.PawnRenderNodePropertiesMultiColor">
                    <nodeClass>Core40k.PawnRenderNode_FlagEdit</nodeClass>
                    <workerClass>Core40k.PawnRenderNodeWorker_Shield</workerClass>
                    <texPath>Things/Shields/Astartes/CombatShieldA/CombatShieldA</texPath>
                    <parentTagDef>Body</parentTagDef>
                    <drawData>
                        <defaultData>
                            <layer>75</layer>
                        </defaultData>
                        <dataNorth>
                            <layer>-5</layer>
                            <offset>(0.0, 0, 0.1)</offset>
                        </dataNorth>
                        <dataEast>
                            <layer>75</layer>
                            <offset>(0.25, 0, 0)</offset>
                        </dataEast>
                        <dataWest>
                            <offset>(-0.25, 0, 0)</offset>
                        </dataWest>
                    </drawData>
                </li>
            </renderNodeProperties>
        </apparel>
        <comps>
            <li Class="Core40k.CompProperties_MultiColor">
                <colorMaskAmount>3</colorMaskAmount>
                <defaultPrimaryColor>(250,176,67)</defaultPrimaryColor>
                <defaultSecondaryColor>(250,176,67)</defaultSecondaryColor>
                <defaultTertiaryColor>(180,65,74)</defaultTertiaryColor>
            </li>
            <li Class="Core40k.CompProperties_AlternateTexture" />
            <li Class="Core40k.CompProperties_PhysicalShield">
                <frontArcDegrees>100</frontArcDegrees>
                <meleeBlockChance>0.4</meleeBlockChance>
                <rangedBlockChance>0.3</rangedBlockChance>
                <sideBlockFactor>0.35</sideBlockFactor>
                <shieldArmorRating>0.55</shieldArmorRating>
            </li>
        </comps>
        <modExtensions>
            <li Class="Core40k.DefModExtension_TextureFlags"/>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="ApparelMakeableBase">

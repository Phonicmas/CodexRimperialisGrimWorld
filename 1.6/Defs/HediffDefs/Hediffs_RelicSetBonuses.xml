<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <HediffDef>
        <defName>BEWH_ValdorsGuard</defName>
        <label>Valdor's guard</label>
        <description>Clad in the full Corinthine warplate, the wearer fights with the unshakable poise of the first Captain-General.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <MeleeDodgeChance>8</MeleeDodgeChance>
                    <MeleeHitChance>4</MeleeHitChance>
                    <PainShockThreshold>0.1</PainShockThreshold>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>BEWH_LionsResolve</defName>
        <label>Lion's resolve</label>
        <description>The full panoply of the Imperial Warden. The wearer fights with the cold, relentless focus of the First Primarch.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <stages>
            <li>
                <statOffsets>
                    <MeleeHitChance>6</MeleeHitChance>
                    <MeleeDodgeChance>4</MeleeDodgeChance>
                    <MoveSpeed>0.3</MoveSpeed>
                </statOffsets>
                <statFactors>
                    <MeleeDamageFactor>1.15</MeleeDamageFactor>
                </statFactors>
            </li>
        </stages>
    </HediffDef>

    <HediffDef>
        <defName>BEWH_EmperorsJudgement</defName>
        <label>Emperor's judgement</label>
        <description>Struck by the psychic wrath of the Emperor. Mind and body reel under the weight of His regard.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <initialSeverity>1</initialSeverity>
        <comps>
            <li Class="HediffCompProperties_Disappears">
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
        <stages>
            <li>
                <painOffset>0.35</painOffset>
                <capMods>
                    <li>
                        <capacity>Consciousness</capacity>
                        <offset>-0.3</offset>
                    </li>
                    <li>
                        <capacity>Moving</capacity>
                        <offset>-0.3</offset>
                    </li>
                </capMods>
            </li>
        </stages>
    </HediffDef>

</Defs>

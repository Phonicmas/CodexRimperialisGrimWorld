    <ThingDef ParentName="BaseBullet">
        <defName>BEWH_MilitarumPlasmaShot</defName>
        <label>plasma shot</label>
        <description>Standard mode: a stabilised bolt of superheated plasma. Safe to fire, and still a serious threat to armoured targets.</description>
        <thingClass>Projectile_Explosive</thingClass>
        <uiIconPath>UI/BEWH_Icon_ModeDefault</uiIconPath>
        <graphicData>
            <texPath>Things/Projectiles/Custodes/Plasma_Projectile</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
        </graphicData>
        <projectile>
            <damageDef>BEWH_MilitarumPlasmaBurn</damageDef>
            <damageAmountBase>26</damageAmountBase>
            <stoppingPower>1.0</stoppingPower>
            <armorPenetrationBase>0.42</armorPenetrationBase>
            <explosionRadius>0.25</explosionRadius>
            <speed>60</speed>
            <explosionEffect>BEWH_PlasmaImpact</explosionEffect>
        </projectile>
        <modExtensions>
            <li Class="Core40k.DefModExtension_AmmoChanger" />
        </modExtensions>
    </ThingDef>
    <ThingDef ParentName="BaseBullet">
        <defName>BEWH_MilitarumPlasmaShotOvercharged</defName>
        <label>overcharged plasma shot</label>
        <description>Overcharge mode: safety limiters disengaged. The coils take longer to charge and the effective range drops, but the bolt detonates in a violent burst of plasma.</description>
        <thingClass>Projectile_Explosive</thingClass>
        <uiIconPath>UI/BEWH_Icon_ModeCharged</uiIconPath>
        <graphicData>
            <texPath>Things/Projectiles/Custodes/Plasma_Projectile</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>1.4</drawSize>
        </graphicData>
        <projectile>
            <damageDef>BEWH_MilitarumPlasmaBurn</damageDef>
            <damageAmountBase>45</damageAmountBase>
            <stoppingPower>1.5</stoppingPower>
            <armorPenetrationBase>0.68</armorPenetrationBase>
            <explosionRadius>1.4</explosionRadius>
            <speed>50</speed>
            <explosionEffect>BEWH_PlasmaImpact</explosionEffect>
        </projectile>
        <modExtensions>
            <li Class="Core40k.DefModExtension_AmmoChanger">
                <effectiveRange>26</effectiveRange>
                <warmupTime>3.2</warmupTime>
                <shotsPerBurst>1</shotsPerBurst>
                <statFactors>
                    <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
                </statFactors>
            </li>
        </modExtensions>
    </ThingDef>

<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <Core40k.ApparelSetDef>
        <defName>BEWH_ApparelSet_GuardFlamerKit</defName>
        <label>promethium kit</label>
        <description>A flamer fed directly from a promethium tank worn on the back.</description>
        <pieces>
            <li>BEWH_GuardFatigues</li>
            <li>BEWH_GuardWebbing</li>
        </pieces>
        <decorations>
            <li>BEWH_Deco_WebbingPromethiumTanks</li>
        </decorations>
        <weaponPieces>
            <li>
                <label>Cadian flamer</label>
                <weapons>
                    <li>BEWH_FlamerCadian</li>
                </weapons>
            </li>
        </weaponPieces>
        <tiers>
            <li>
                <requiredCount>3</requiredCount>
                <label>promethium feed</label>
                <requiresWeapon>true</requiresWeapon>
                <requiredDecorations>
                    <li>BEWH_Deco_WebbingPromethiumTanks</li>
                </requiredDecorations>
                <statFactors>
                    <RangedCooldownFactor>0.7</RangedCooldownFactor>
                </statFactors>
                <verbModifier>
                    <additionalRange>2.2</additionalRange>
                </verbModifier>
            </li>
        </tiers>
    </Core40k.ApparelSetDef>


            <li>BEWH_GuardWebbing</li>
        </appliesTo>
        <appliesToBodyTypes>
            <li>Male</li>
            <li>Female</li>
            <li>Hulk</li>
            <li>Thin</li>
            <li>Fat</li>
        </appliesToBodyTypes>
        <defaultShowRotation>
            <li>North</li>
            <li>East</li>
            <li>West</li>
        </defaultShowRotation>
        <drawData>
            <dataNorth>
                <layer>90</layer>
            </dataNorth>
            <dataEast>
                <layer>33</layer>
            </dataEast>
            <dataWest>
                <layer>33</layer>
            </dataWest>
        </drawData>
        <shaderType>Cutout</shaderType>
        <decorationType>BEWH_DecoCategory_Misc</decorationType>
        <incompatibleDecorations>
            <li>BEWH_Deco_WebbingPowerPack</li>
            <li>BEWH_Deco_WebbingPromethiumTanks</li>
            <li>BEWH_Deco_WebbingBattlelineBackpack</li>

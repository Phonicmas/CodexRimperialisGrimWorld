                <layer>95</layer>
            </dataNorth>
            <dataSouth>
                <layer>-1</layer>
            </dataSouth>
            <dataEast>
                <offset>(-0.2,0,0)</offset>
                <layer>71</layer>
            </dataEast>
            <dataWest>
                <offset>(0.2,0,0)</offset>
                <layer>71</layer>
            </dataWest>
        </drawData>
        <shaderType>Cutout</shaderType>
        <decorationType>BEWH_DecoCategory_Misc</decorationType>
        <mustHaveResearch>

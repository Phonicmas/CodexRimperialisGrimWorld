<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <AbilityDef Name="BEWH_JumpPackAbilityBase" Abstract="True">
        <hostile>false</hostile>
        <casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
        <jobDef>CastJump</jobDef>
        <verbProperties>
            <verbClass>Verb_CastAbilityJump</verbClass>
            <label>jump</label>
            <violent>false</violent>
            <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
            <requireLineOfSight>true</requireLineOfSight>
            <warmupEffecter MayRequire="Ludeon.RimWorld.Royalty">JumpWarmupEffect</warmupEffecter>
            <flightEffecterDef MayRequire="Ludeon.RimWorld.Royalty">JumpFlightEffect</flightEffecterDef>
            <soundLanding MayRequire="Ludeon.RimWorld.Royalty">JumpPackLand</soundLanding>
            <targetParams>
                <canTargetLocations>true</canTargetLocations>
                <canTargetPawns>false</canTargetPawns>
                <canTargetBuildings>false</canTargetBuildings>
            </targetParams>
        </verbProperties>
    </AbilityDef>

    <AbilityDef ParentName="BEWH_JumpPackAbilityBase">
        <defName>BEWH_VenatariJump</defName>
        <label>Venatari jump</label>
        <description>Ignite the Venatari jump pack and leap to a distant location.</description>
        <iconPath>Things/Armor/Custodes/Backpack/Venatari/Venatari_icon</iconPath>
        <cooldownTicksRange>1800</cooldownTicksRange>
        <verbProperties>
            <warmupTime>0.75</warmupTime>
            <range>22.5</range>
        </verbProperties>
    </AbilityDef>

    <AbilityDef ParentName="BEWH_JumpPackAbilityBase">
        <defName>BEWH_ElysianJump</defName>
        <label>grav-chute jump</label>
        <description>Fire the Elysian jetpack and leap to a nearby position.</description>
        <iconPath>Things/Decorations/Guard/Elysian/ElysianJetpack/ElysianJetpack_icon</iconPath>
        <cooldownTicksRange>2400</cooldownTicksRange>
        <verbProperties>
            <warmupTime>1</warmupTime>
            <range>19.9</range>
        </verbProperties>
    </AbilityDef>

</Defs>

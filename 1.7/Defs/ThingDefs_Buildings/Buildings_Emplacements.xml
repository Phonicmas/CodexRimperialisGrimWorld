        </researchPrerequisites>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>BEWH_AstartesHeavyBoltRound</defName>
        <label>heavy bolter round</label>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Big</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>1.2</drawSize>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>31</damageAmountBase>
            <armorPenetrationBase>0.46</armorPenetrationBase>
            <stoppingPower>0.45</stoppingPower>
            <speed>70</speed>
        </projectile>
    </ThingDef>

    <ThingDef ParentName="BEWH_AstartesTurretBase">
        <defName>BEWH_AstartesBolterTurret</defName>
        <label>Astartes bolter turret</label>
        <description>A turret emplacement of Adeptus Astartes design, using technology borrowed from the Tarantula auto-turret. This turret is armed with a twin-linked heavy bolter of even higher power than normal.\n\nThe Adeptus Astartes, favoring high-mobility warfare as they do, rarely use static defenses. Any turrets that they do use are strictly unmanned, to avoid removing precious Space Marines from the offensive.</description>
        <uiIconPath>Things/Buildings/AstartesTurret/BEWH_AstartesTurret_BolterUI</uiIconPath>
        <comps>
            <li Class="CompProperties_Forbiddable"/>
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Shots until reload</fuelLabel>
                <fuelGizmoLabel>Current ammo</fuelGizmoLabel>
                <outOfFuelMessage>Needs more ammo</outOfFuelMessage>
                <fuelFilter><thingDefs><li>Steel</li></thingDefs></fuelFilter>
                <fuelCapacity>250</fuelCapacity>
                <fuelMultiplier>1</fuelMultiplier>
                <initialFuelPercent>1</initialFuelPercent>
                <autoRefuelPercent>0.5</autoRefuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>1</minimumFueledThreshold>
                <factorByDifficulty>true</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
            </li>
        </comps>
        <building>
            <turretGunDef>BEWH_AstartesBolterTurretGun</turretGunDef>
            <turretBurstCooldownTime>3.5</turretBurstCooldownTime>
        </building>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>BEWH_AstartesBolterTurretGun</defName>
        <label>heavy bolter turret</label>
        <description>A high-powered heavy bolter, aimed and fired by the machine spirit of the turret emplacement's systems.</description>
        <recoilPower>3</recoilPower>
        <graphicData>
            <texPath>Things/Buildings/AstartesTurret/BEWH_AstartesTurret_BolterTop</texPath>
        </graphicData>
        <statBases>
            <Mass>15</Mass>
            <AccuracyTouch>0.85</AccuracyTouch>
            <AccuracyShort>0.78</AccuracyShort>
            <AccuracyMedium>0.70</AccuracyMedium>
            <AccuracyLong>0.55</AccuracyLong>
            <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
            <DeteriorationRate>0</DeteriorationRate>
            <Flammability>0</Flammability>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <defaultProjectile>BEWH_AstartesHeavyBoltRound</defaultProjectile>
                <warmupTime>0</warmupTime>
                <range>40</range>
                <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
                <burstShotCount>10</burstShotCount>
                <soundCast>BEWH_Heavy_Bolt_Gun_Sound</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>8</muzzleFlashScale>
                <consumeFuelPerShot>1</consumeFuelPerShot>
            </li>
        </verbs>
    </ThingDef>

    <ThingDef ParentName="BaseBullet" Class="VEF.Weapons.LaserBeamDef">
        <defName>BEWH_AstartesLascannonBeam</defName>
        <label>lascannon shot</label>
        <thingClass>VEF.Weapons.LaserBeam</thingClass>
        <drawOffscreen>true</drawOffscreen>
        <beamGraphic>BEWH_GrimBeamGraphic</beamGraphic>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
            <texPath>Things/Projectiles/Custodes/Las_Bolt</texPath>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>2.5</drawSize>
        </graphicData>
        <explosionEffect>BEWH_GrimLaserImpact</explosionEffect>
        <hitLivingEffect>BEWH_GrimLaserLivingImpact</hitLivingEffect>
        <projectile>
            <damageDef>Burn</damageDef>
            <damageAmountBase>57</damageAmountBase>
            <armorPenetrationBase>0.85</armorPenetrationBase>
            <stoppingPower>2</stoppingPower>
            <speed>1000</speed>
        </projectile>
        <seam>0</seam>
        <textures>
            <li>Things/Projectiles/Custodes/Las_Bolt</li>
        </textures>
        <causefireChance>0.1</causefireChance>
    </ThingDef>

    <ThingDef ParentName="BEWH_AstartesTurretBase">
        <defName>BEWH_AstartesLascannonTurret</defName>
        <label>Astartes lascannon turret</label>
        <description>A turret emplacement designed by the Adeptus Astartes. This version is armed with a high-powered lascannon to pick off heavy infantry and light armor from long range.\n\nLasbolt wounds are ugly, brutal things - burned meat, scorched bone, and severed limbs. With a lascannon this powerful, a direct hit is likely to burn off even a limb encased in Power Armor.</description>
        <uiIconPath>Things/Buildings/AstartesTurret/BEWH_AstartesTurret_LascannonUI</uiIconPath>
        <comps>
            <li Class="CompProperties_Explosive">
                <wickTicks>240</wickTicks>
                <explosiveRadius>5.9</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
                <chanceNeverExplodeFromDamage>0.5</chanceNeverExplodeFromDamage>
            </li>
            <li Class="CompProperties_Forbiddable"/>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>1500</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
        </comps>
        <building>
            <turretGunDef>BEWH_AstartesLascannonTurretGun</turretGunDef>
            <turretBurstCooldownTime>3.2</turretBurstCooldownTime>
        </building>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>BEWH_AstartesLascannonTurretGun</defName>
        <label>lascannon turret</label>
        <description>A high-powered lascannon, aimed and fired by the machine spirit of the turret emplacement's systems.</description>
        <recoilPower>3</recoilPower>
        <graphicData>
            <texPath>Things/Buildings/AstartesTurret/BEWH_AstartesTurret_LascannonTop</texPath>
        </graphicData>
        <statBases>
            <Mass>15</Mass>
            <AccuracyTouch>0.4</AccuracyTouch>
            <AccuracyShort>0.55</AccuracyShort>
            <AccuracyMedium>0.87</AccuracyMedium>
            <AccuracyLong>0.95</AccuracyLong>
            <RangedWeapon_Cooldown>3.2</RangedWeapon_Cooldown>
            <DeteriorationRate>0</DeteriorationRate>
            <Flammability>0</Flammability>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <defaultProjectile>BEWH_AstartesLascannonBeam</defaultProjectile>
                <warmupTime>2</warmupTime>
                <range>40</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>BEWH_LascannonSound</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>8</muzzleFlashScale>
            </li>
        </verbs>
    </ThingDef>
</Defs>

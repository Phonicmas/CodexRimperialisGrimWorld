<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BaseArtilleryBuilding">
        <defName>BEWH_EarthshakerCannon</defName>
        <label>Earthshaker cannon</label>
        <description>An emplaced Earthshaker cannon, the standard artillery gun of the Astra Militarum. It fires powerful 132mm rounds, pounding targets to dust at long range. Though it is not the most accurate artillery in the galaxy, it makes up for it with its large blast radius and its simplicity, allowing it to be deployed in large numbers by the Guard. Though the typical round is high-explosive, other rounds are available, such as smoke, incendiary, and even diamantine-tipped armor-piercing rounds for the heaviest of targets.\n\nThese guns are typically mounted on a dedicated vehicle chassis, forming the Basilisk self-propelled artillery piece. Other notable artillery pieces include the Manticore missile tank, the Griffon heavy mortar carrier, and the Deathstrike tactical ballistic missile launcher - the latter of which can fire payloads powerful enough to obliterate entire armored companies.</description>
        <graphicData>
            <texPath>Things/Buildings/Earthshaker/BEWH_Earthshaker_Base</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(6,6)</drawSize>
        </graphicData>
        <uiIconPath>Things/Buildings/Earthshaker/BEWH_Earthshaker_MenuIcon</uiIconPath>
        <uiIconScale>1.1</uiIconScale>
        <statBases>
            <MaxHitPoints>500</MaxHitPoints>
            <WorkToBuild>4000</WorkToBuild>
            <Mass>100</Mass>
        </statBases>
        <techLevel>Industrial</techLevel>
        <size>(5,5)</size>
        <rotatable>true</rotatable>
        <interactionCellOffset>(0,0,-3)</interactionCellOffset>
        <costStuffCount>250</costStuffCount>
        <costList>
            <Steel>150</Steel>
            <ReinforcedBarrel>1</ReinforcedBarrel>
            <ComponentIndustrial>9</ComponentIndustrial>
        </costList>
        <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <constructionSkillPrerequisite>9</constructionSkillPrerequisite>
        <comps>
            <li Class="CompProperties_Explosive">
                <wickTicks>240</wickTicks>
                <explosiveRadius>4.9</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
            </li>
            <li Class="CompProperties_Stunnable">
                <affectedDamageDefs>
                    <li>Stun</li>
                    <li>EMP</li>
                </affectedDamageDefs>
            </li>
        </comps>
        <building>
            <turretGunDef>BEWH_EarthshakerGun</turretGunDef>
            <turretTopDrawSize>8</turretTopDrawSize>
            <turretBurstWarmupTime>4</turretBurstWarmupTime>
            <turretBurstCooldownTime>5</turretBurstCooldownTime>
            <buildingTags>
                <li>Artillery_BaseDestroyer</li>
            </buildingTags>
            <defaultStorageSettings Inherit="False">
                <filter>
                    <categories>
                        <li>BEWH_EarthshakerShells</li>
                    </categories>
                </filter>
            </defaultStorageSettings>
        </building>
        <researchPrerequisites Inherit="False">
            <li>BEWH_MilitarumArtillery</li>
        </researchPrerequisites>
    </ThingDef>

    <ThingDef ParentName="BaseArtilleryWeapon">
        <defName>BEWH_EarthshakerGun</defName>
        <label>Earthshaker</label>
        <description>The 132mm gun of an emplaced Earthshaker cannon.</description>
        <recoilPower>5</recoilPower>
        <graphicData>
            <texPath>Things/Buildings/Earthshaker/BEWH_Earthshaker_Gun</texPath>
        </graphicData>
        <statBases>
            <RangedWeapon_Cooldown>5.5</RangedWeapon_Cooldown>
        </statBases>
        <weaponTags>
            <li>Artillery_BaseDestroyer</li>
        </weaponTags>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
                <hasStandardCommand>true</hasStandardCommand>
                <warmupTime>2</warmupTime>
                <forcedMissRadius>12</forcedMissRadius>
                <isMortar>true</isMortar>
                <requireLineOfSight>false</requireLineOfSight>
                <minRange>29.9</minRange>
                <range>500</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>BEWH_EarthshakerSound</soundCast>
                <muzzleFlashScale>32</muzzleFlashScale>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
        <comps>
            <li Class="CompProperties_ChangeableProjectile" />
        </comps>
        <building>
            <fixedStorageSettings>
                <filter>
                    <categories>
                        <li>BEWH_EarthshakerShells</li>
                    </categories>
                </filter>
            </fixedStorageSettings>
            <defaultStorageSettings>
                <filter>
                    <categories>
                        <li>BEWH_EarthshakerShells</li>
                    </categories>
                </filter>
            </defaultStorageSettings>
        </building>
    </ThingDef>

    <ThingDef Name="BEWH_AstartesTurretBase" ParentName="AutocannonTurret" Abstract="True">
        <graphicData>
            <texPath>Things/Buildings/AstartesTurret/BEWH_AstartesTurret_Base</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(4,4)</drawSize>
            <drawOffset>(0,0,0)</drawOffset>
            <damageData>
                <rect>(0.2,0.2,0.6,0.6)</rect>
            </damageData>
            <shadowData>
                <volume>(1.5,0.35,1.4)</volume>
                <offset>(0,0,-0.05)</offset>
            </shadowData>
        </graphicData>
        <uiIconScale>1.1</uiIconScale>
        <minifiedDef>MinifiedThing</minifiedDef>
        <rotatable>true</rotatable>
        <size>(3,3)</size>
        <fillPercent>0.5</fillPercent>
        <thingCategories>
            <li>BuildingsSecurity</li>
        </thingCategories>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <constructionSkillPrerequisite>14</constructionSkillPrerequisite>
        <stuffCategories>
            <li>Metallic</li>
        </stuffCategories>
        <costStuffCount>200</costStuffCount>
        <costList>
            <Steel>200</Steel>
            <Plasteel>140</Plasteel>
            <ComponentIndustrial>18</ComponentIndustrial>
            <ComponentSpacer>3</ComponentSpacer>
        </costList>
        <statBases>
            <MaxHitPoints>630</MaxHitPoints>
            <Mass>15</Mass>
            <ShootingAccuracyTurret>0.98</ShootingAccuracyTurret>
        </statBases>
        <researchPrerequisites>

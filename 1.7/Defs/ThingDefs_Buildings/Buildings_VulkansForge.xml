<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BenchBase">
        <defName>BEWH_VulkansForge</defName>
        <label>Vulkan's Forge</label>
        <description>A master forge patterned on the great works of the Primarch Vulkan. Its fires and servo-arms are precise enough to shape auramite and the relic armor of the Imperium's greatest heroes.</description>
        <thingClass>Building_WorkTable</thingClass>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Things/Buildings/VulkanForge/RotI_Forge</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(6.5,6.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <uiIconPath>Things/Buildings/VulkanForge/RotI_Forge_south</uiIconPath>
        <castEdgeShadows>false</castEdgeShadows>
        <statBases>
            <WorkToBuild>35000</WorkToBuild>
            <Flammability>0</Flammability>
            <Cleanliness>0</Cleanliness>
            <MaxHitPoints>600</MaxHitPoints>
        </statBases>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <size>(5,5)</size>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <uiOrder>2520</uiOrder>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-3)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <constructionSkillPrerequisite>12</constructionSkillPrerequisite>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>2000</basePowerConsumption>
                <idlePowerDraw>500</idlePowerDraw>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Glower">
                <glowRadius>5</glowRadius>
                <glowColor>(73,123,138,0)</glowColor>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
            <li Class="CompProperties_Breakdownable"/>
        </comps>
        <building>
            <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
            <workTableRoomRole>Workshop</workTableRoomRole>
            <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
        </building>
        <constructEffect>ConstructMetal</constructEffect>
        <designationHotKey>Misc7</designationHotKey>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
        <researchPrerequisites Inherit="False">
            <li>BEWH_ForgeOfVulkan</li>
        </researchPrerequisites>
        <costList>
            <Plasteel>400</Plasteel>
            <Uranium>150</Uranium>
            <Gold>150</Gold>
            <ComponentSpacer>12</ComponentSpacer>
        </costList>
        <modExtensions>
            <li Class="Core40k.DefModExtension_AllowColoringOfThings">
                <allowColoringOfApparel>true</allowColoringOfApparel>
            </li>
        </modExtensions>
    </ThingDef>
    <WorkGiverDef>
        <defName>BEWH_DoBillsVulkansForge</defName>
        <label>forge relics</label>
        <giverClass>WorkGiver_DoBill</giverClass>
        <workType>Crafting</workType>
        <priorityInType>50</priorityInType>
        <fixedBillGiverDefs>
            <li>BEWH_VulkansForge</li>
        </fixedBillGiverDefs>
        <verb>forge</verb>
        <gerund>forging at</gerund>
        <requiredCapacities>
            <li>Manipulation</li>
        </requiredCapacities>
        <prioritizeSustains>true</prioritizeSustains>
    </WorkGiverDef>
</Defs>

    <ThingDef ParentName="BEWH_ImperialStatueBase">
        <defName>BEWH_StatueSisterOfBattle</defName>
        <label>Sister of Battle statue</label>
        <description>A small sculpture on a pedestal, depicting a zealot Battle-Sister of the Adepta Sororitas. \n\nHer struggle is one of absolute faith, burning the xeno, the mutant, and the witch without mercy. She believes what she is doing is an absolute good, the wishes of the God-Emperor of Mankind Himself.</description>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Buildings/Furniture/Statues/Small/Statue1x1_SisterSword</texPath>
            <drawSize>(2,2)</drawSize>
            <drawOffset>(0,0,0.35)</drawOffset>
        </graphicData>
        <size>(1,1)</size>
        <fillPercent>0.25</fillPercent>
        <castEdgeShadows>false</castEdgeShadows>
        <rotatable>true</rotatable>
        <defaultPlacingRot>South</defaultPlacingRot>
        <statBases>
            <MaxHitPoints>90</MaxHitPoints>
            <Mass>2</Mass>
            <Beauty>50</Beauty>
            <WorkToMake>18000</WorkToMake>
        </statBases>
        <stuffCategories>
            <li>Metallic</li>
            <li>Woody</li>
            <li>Stony</li>
        </stuffCategories>
        <recipeMaker>
            <researchPrerequisites Inherit="False">
                <li>BEWH_ImperialIconography</li>
            </researchPrerequisites>
        </recipeMaker>
        <costStuffCount>50</costStuffCount>
    </ThingDef>
    <ThingDef ParentName="BEWH_ImperialStatueBase">
        <defName>BEWH_StatueFlagbearer</defName>
        <label>Flagbearer statue</label>
        <description>A small sculpture on a pedestal, depicting a heroic Guardsman bearing a flag. \n\nHis struggle is one of survival. He trusts only in the Emperor and the man beside him, and prays that the horrors he faces will be torn apart by lasbolts before they consume him.</description>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <texPath>Things/Buildings/Furniture/Statues/Small/Statue1x1_GuardsmanFlag</texPath>

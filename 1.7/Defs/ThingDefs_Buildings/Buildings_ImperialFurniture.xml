            <li>
                <compClass>CompGatherSpot</compClass>
            </li>
            <li Class="CompProperties_Glower">
                <glowRadius>10</glowRadius>
                <glowColor>(252,187,113,0)</glowColor>
            </li>
            <li Class="CompProperties_Refuelable">
                <fuelConsumptionRate>10.0</fuelConsumptionRate>
                <fuelCapacity>50.0</fuelCapacity>
                <fuelFilter>
                    <thingDefs>
                        <li>WoodLog</li>
                    </thingDefs>
                </fuelFilter>
                <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
            </li>
            <li Class="CompProperties_HeatPusher">
                <compClass>CompHeatPusherPowered</compClass>
                <heatPerSecond>32</heatPerSecond>
                <heatPushMaxTemperature>21</heatPushMaxTemperature>
            </li>
            <li Class="CompProperties_FireOverlay">
                <fireSize>0.8</fireSize>
                <offset>(0,0,0.1)</offset>
                <offsetNorth>(0,-1,0)</offsetNorth>
                <offsetEast>(0.3,-0.1,0)</offsetEast>
                <offsetWest>(-0.3,-0.1,0)</offsetWest>
            </li>
        </comps>
        <researchPrerequisites Inherit="False">
            <li>BEWH_GildedHalls</li>
        </researchPrerequisites>
    </ThingDef>
    <ThingDef ParentName="BEWH_ImperialHearthBase">
        <defName>BEWH_ImperialHearth</defName>
        <label>hearth</label>
        <description>A hearth. A source of light and heat for more well-to-do commoners. \n\nThe Imperium is advanced in many ways, yet regressive in others. Many a tech-priest has repaired a plasma gun by candlelight.</description>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Hearth/Hearth</texPath>
        </graphicData>
        <statBases>
            <Beauty>5</Beauty>
            <WorkToBuild>2000</WorkToBuild>
        </statBases>
    </ThingDef>
    <ThingDef ParentName="BEWH_ImperialHearthBase">
        <defName>BEWH_ImperialRoyalHearth</defName>
        <label>royal hearth</label>
        <description>An ornate hearth. Warms the cold hearts of Imperial nobility. \n\nIt is only natural for the worst of the Imperium's nobles to fall into heretical cults. With so much wealth and power, their minds wander to exotic tastes.</description>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Hearth/RoyalHearth</texPath>
        </graphicData>
        <costList>
            <Gold>50</Gold>
        </costList>
        <statBases>
            <Beauty>30</Beauty>
            <WorkToBuild>10000</WorkToBuild>
        </statBases>
    </ThingDef>

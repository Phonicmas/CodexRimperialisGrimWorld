    <ThingDef Name="BEWH_ImperialRoyalTableBase" ParentName="TableGatherSpotBase" Abstract="True">
        <description>An impressive table fit for Imperial nobility. \n\nEven the lavish meals of the rimworld pale in comparison to the daily foodstuffs of Imperial nobles. There, such exquisite taste can be found as to border on madness, with only the best acceptable - some nobles even have the luxury of tasting traded delicacies of the Eldar craftworlds. Even the scraps of such meals would be an inconceivable delight to the commoners.</description>
        <graphicData>
            <graphicClass>Graphic_Multi</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <damageData>
                <rect>(0.15,0.15,0.2,0.2)</rect>

    <ThingDef ParentName="BEWH_ImperialCandleBase">
        <defName>BEWH_ImperialCandle</defName>
        <label>candle</label>
        <description>A single candle. Provides light in times of darkness. \n\nWhile wax candles are widespread in the Imperium of Man, there are also candles of tallow - some made of dead animals, while others made of human corpses.</description>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Candles/Candle</texPath>
        </graphicData>
    </ThingDef>
    <ThingDef ParentName="BEWH_ImperialCandleBase">
        <defName>BEWH_ImperialCandleBunch</defName>
        <label>candle bunch</label>
        <description>A cluster of candles. Provides light in times of darkness. \n\nWhile wax candles are widespread in the Imperium of Man, there is also candles of tallow - some made of dead animals, while others made of human corpses.</description>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Candles/CandlesWax</texPath>
        </graphicData>
    </ThingDef>
    <ThingDef ParentName="BEWH_ImperialCandleBase">
        <defName>BEWH_ImperialCandelabra</defName>
        <label>candelabra</label>
        <description>A metal candelabra. Suitable for church ceremony and nobleman's mansion alike. \n\nIt is true, great cruelty is present on the rimworlds. But it all pales in comparison to the churning, industrial cruelty of the Imperium of Man. To see such things, all one has to do is observe a candle's light - it is made of burning dead.</description>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Candles/Candelabra</texPath>
        </graphicData>
        <tickerType>Normal</tickerType>
        <costList>
            <Steel>10</Steel>
        </costList>
        <comps>
            <li Class="CompProperties_Glower">
                <glowRadius>3</glowRadius>
                <glowColor>(252,187,113,0)</glowColor>
            </li>
        </comps>
    </ThingDef>

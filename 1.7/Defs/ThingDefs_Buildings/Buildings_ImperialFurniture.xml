<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="Bed">
        <defName>BEWH_ImperialPrisonerBed</defName>
        <label>Prisoner bed</label>
        <description>Not quite a bed, but a position of restraint. From here, a heretic's penitence begins. \n\nThe Imperium brooks no dissent. "Heresy" includes not only worship of the Chaos Gods, but also any action or belief that works against the Imperium.</description>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <defaultPlacingRot>South</defaultPlacingRot>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Bed/PrisonerBed/Bed_Prison</texPath>
            <drawOffset>(0,0.01,0)</drawOffset>
        </graphicData>
        <building>
            <bed_showSleeperBody>True</bed_showSleeperBody>
        </building>
        <researchPrerequisites Inherit="False">
            <li>BEWH_ImperialFurnishings</li>
        </researchPrerequisites>
    </ThingDef>
    <ThingDef ParentName="Bed">
        <defName>BEWH_ImperialNobleBed</defName>
        <label>Noble single bed</label>
        <description>An ornate bed, suitable for the highborn of the Imperium of Man - the nobility. \n\nThe highborn live a life entirely different to that of common Imperial citizens - a life of immense wealth, power, and influence. That is not to say it is without its own dangers - shunning by their peers, assassins in the night, and the temptations of the Chaos Gods in the form of cults and cliques.</description>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <defaultPlacingRot>South</defaultPlacingRot>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Bed/RoyalBedSingle/Bed_RoyalSingle</texPath>
            <drawSize>(4.05,4.05)</drawSize>
            <drawRotated>false</drawRotated>
        </graphicData>
        <statBases>
            <MaxHitPoints>200</MaxHitPoints>
            <WorkToBuild>35000</WorkToBuild>
            <Mass>60</Mass>
            <Beauty>50</Beauty>
            <BedRestEffectiveness>1.05</BedRestEffectiveness>
            <Comfort>0.90</Comfort>
        </statBases>
        <costList>
            <Gold>30</Gold>
        </costList>
        <thingSetMakerTags>
            <li>RewardStandardQualitySuper</li>
        </thingSetMakerTags>
        <researchPrerequisites Inherit="False">
            <li>BEWH_GildedHalls</li>
        </researchPrerequisites>
        <costStuffCount>60</costStuffCount>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    </ThingDef>

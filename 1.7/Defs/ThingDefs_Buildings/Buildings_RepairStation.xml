<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BenchBase">
        <defName>BEWH_RepairStation</defName>
        <label>repair station</label>
        <description>A workbench with the necessary equipment for repair and maintenance of Imperial equipment - not just mere tools, but incense, blessed oils, and other trappings of worship of the Omnissiah. Restoring a damaged weapon or piece of apparel costs a share of the materials it was made from, scaled by how badly it is damaged.\n\nThe Adeptus Mechanicus are a religious order just as much as they are technicians and engineers. They deeply believe in "placating the Machine Spirits" with rituals - the actual efficacy of those rituals ranges from being effective but misunderstood to being completely useless. Still, there remains a grain of truth in most of them, even if it is buried in superstition.</description>
        <thingClass>Building_WorkTable</thingClass>
        <graphicData>
            <texPath>Things/Buildings/RepairStation/BEWH_RepairStation</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(3.5,1.5)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <uiIconPath>Things/Buildings/RepairStation/BEWH_RepairStation_south</uiIconPath>
        <castEdgeShadows>true</castEdgeShadows>
        <staticSunShadowHeight>0.20</staticSunShadowHeight>
        <statBases>
            <MaxHitPoints>180</MaxHitPoints>
            <WorkToBuild>3000</WorkToBuild>
            <Flammability>1.0</Flammability>
            <Cleanliness>-2</Cleanliness>
        </statBases>
        <costList>
            <Steel>150</Steel>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <altitudeLayer>Building</altitudeLayer>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <size>(3,1)</size>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <uiOrder>2520</uiOrder>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
        <inspectorTabs>
            <li>ITab_Bills</li>
        </inspectorTabs>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>250</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Glower">
                <glowRadius>5</glowRadius>
                <glowColor>(73,123,138,0)</glowColor>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>ToolCabinet</li>
                </linkableFacilities>
            </li>
            <li Class="CompProperties_Breakdownable"/>
        </comps>
        <building>
            <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
            <workTableRoomRole>Workshop</workTableRoomRole>
            <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
        </building>
        <constructEffect>ConstructMetal</constructEffect>
        <placeWorkers>
            <li>PlaceWorker_ShowFacilitiesConnections</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
        <researchPrerequisites Inherit="False">
            <li>BEWH_RitesOfMaintenance</li>
        </researchPrerequisites>
    </ThingDef>

    <WorkGiverDef>
        <defName>BEWH_DoBillsRepairStation</defName>
        <label>repair equipment at repair station</label>
        <giverClass>WorkGiver_DoBill</giverClass>
        <workType>Crafting</workType>
        <priorityInType>45</priorityInType>
        <fixedBillGiverDefs>
            <li>BEWH_RepairStation</li>
        </fixedBillGiverDefs>
        <verb>repair</verb>
        <gerund>repairing at</gerund>
        <requiredCapacities>
            <li>Manipulation</li>
        </requiredCapacities>
        <prioritizeSustains>true</prioritizeSustains>
    </WorkGiverDef>

    <RecipeDef Name="BEWH_RepairRecipeBase" Abstract="True">
        <workerClass>Core40k.RecipeWorker_RepairEquipment</workerClass>
        <recipeUsers>
            <li>BEWH_RepairStation</li>
        </recipeUsers>
        <workAmount>500</workAmount>
        <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
        <workSkill>Crafting</workSkill>
        <effectWorking>Smith</effectWorking>
        <soundWorking>Recipe_Smith</soundWorking>
        <skillRequirements>
            <Crafting>4</Crafting>
        </skillRequirements>
        <modExtensions>
            <li Class="Core40k.DefModExtension_RepairRecipe" />
        </modExtensions>
    </RecipeDef>

    <RecipeDef ParentName="BEWH_RepairRecipeBase">
        <defName>BEWH_RepairWeapon</defName>
        <label>repair weapon</label>
        <description>Restore a damaged weapon to full condition. Costs a share of the materials the weapon was made from, and takes longer, the more damaged it is.</description>
        <jobString>Repairing weapon.</jobString>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>Weapons</li>
                    </categories>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>Weapons</li>
            </categories>
            <allowedHitPointsPercents>0~0.99</allowedHitPointsPercents>
        </fixedIngredientFilter>
    </RecipeDef>

    <RecipeDef ParentName="BEWH_RepairRecipeBase">
        <defName>BEWH_RepairApparel</defName>
        <label>repair apparel</label>
        <description>Restore a damaged piece of apparel to full condition. Costs a share of the materials the apparel was made from, and takes longer, the more damaged it is.</description>
        <jobString>Repairing apparel.</jobString>
        <ingredients>
            <li>
                <filter>
                    <categories>
                        <li>Apparel</li>
                    </categories>
                </filter>
                <count>1</count>
            </li>
        </ingredients>
        <fixedIngredientFilter>
            <categories>
                <li>Apparel</li>
            </categories>
            <allowedHitPointsPercents>0~0.99</allowedHitPointsPercents>
        </fixedIngredientFilter>
    </RecipeDef>
</Defs>

<Defs>

    <ThingDef ParentName="ArmorMachineableBase">
        <defName>BEWH_CustodianArmor</defName>
        <label>Custodian armor</label>
        <description>A suit of Power Armor built for the Adeptus Custodes, the right hand of the Talons of the Emperor. Built from the golden material known as Auramite, its strength greatly exceeds that of a Space Marine's equivalent armor.\n\nThe Adeptus Custodes are, among other names, also known as the Ten Thousand. For most of their history, stretching back to the Unification Wars on Terra, there have indeed been ten thousand of them. However, during the War Within the Webway, the fighting was so brutal that their number was reduced down to a mere thousand, though they eventually recovered.</description>
        <techLevel>Spacer</techLevel>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Things/Armor/Custodes/Body/ShieldHost/ShieldHost</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>BEWH_CutoutThreeColor</shaderType>
            <drawSize>1</drawSize>
        </graphicData>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <skillRequirements>
                <Crafting>14</Crafting>
            </skillRequirements>
            <recipeUsers Inherit="false">
                <li>FabricationBench</li>
            </recipeUsers>
            <researchPrerequisites Inherit="False">
                <li>BEWH_AuramiteForging</li>
            </researchPrerequisites>
        </recipeMaker>
        <statBases>
            <MaxHitPoints>5500</MaxHitPoints>
            <Mass>14</Mass>
            <Flammability>0</Flammability>
            <EquipDelay>15</EquipDelay>
            <DeteriorationRate>0.5</DeteriorationRate>
            <Beauty>5</Beauty>
            <WorkToMake>100000</WorkToMake>
            <MarketValue>11000</MarketValue>
            <ArmorRating_Sharp>1.85</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.78</ArmorRating_Blunt>
            <ArmorRating_Heat>1.25</ArmorRating_Heat>
            <Insulation_Cold>40</Insulation_Cold>
            <Insulation_Heat>22</Insulation_Heat>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>-3.0</MoveSpeed>
            <PainShockThreshold>0.05</PainShockThreshold>
            <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.4</SlaveSuppressionOffset>
            <TerrorSource MayRequire="Ludeon.RimWorld.Ideology">17</TerrorSource>
            <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.35</VacuumResistance>
            <DecompressionResistance MayRequire="kentington.saveourship2">0.75</DecompressionResistance>
            <HypoxiaResistance MayRequire="kentington.saveourship2">1</HypoxiaResistance>
        </equippedStatOffsets>
        <costList>
            <ComponentSpacer>8</ComponentSpacer>
            <Plasteel>200</Plasteel>
            <Uranium>60</Uranium>
            <Gold>40</Gold>
        </costList>
        <thingCategories>
            <li>ApparelArmor</li>
        </thingCategories>
        <apparel>
            <wornGraphicPath>Things/Armor/Custodes/Body/ShieldHost/ShieldHost</wornGraphicPath>
            <useWornGraphicMask>true</useWornGraphicMask>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <bodyPartGroups>
                <li>Torso</li>
                <li>Neck</li>
                <li>Shoulders</li>
                <li>Arms</li>
                <li>Legs</li>
                <li>Hands</li>
                <li>Feet</li>
            </bodyPartGroups>
            <layers>
                <li>Shell</li>
                <li>Middle</li>
            </layers>
            <drawData>
                <dataNorth>
                    <layer>74</layer>
                </dataNorth>
                <dataWest>
                    <layer>70</layer>
                </dataWest>
                <dataEast>
                    <layer>70</layer>
                </dataEast>
                <scale>1.1</scale>
                <childScale>1.1</childScale>
            </drawData>
            <defaultOutfitTags>
                <li>Soldier</li>
            </defaultOutfitTags>
            <tags>
                <li>BEWH_CustodianArmor</li>
                <li>EVA</li>
            </tags>
        </apparel>
        <tradeTags>
            <li>HiTechArmor</li>
        </tradeTags>
        <thingSetMakerTags Inherit="False" />
        <smeltable>false</smeltable>
        <burnableByRecipe>true</burnableByRecipe>
        <tradeability>Sellable</tradeability>
        <comps>
            <li Class="Core40k.CompProperties_MultiColor">
                <colorMaskAmount>3</colorMaskAmount>
                <defaultPrimaryColor>(250,176,67)</defaultPrimaryColor>
                <defaultSecondaryColor>(250,176,67)</defaultSecondaryColor>
                <defaultTertiaryColor>(180,65,74)</defaultTertiaryColor>
            </li>
            <li Class="Core40k.CompProperties_Decorative">
                <decorations>
                    <li>BEWH_CustodianShoulderShieldHost</li>
                </decorations>
            </li>
            <li Class="Core40k.CompProperties_AlternateTexture" />
            <li MayRequire="kentington.saveourship2">
                <compClass>SaveOurShip2.CompEVA</compClass>
            </li>
        </comps>
        <modExtensions>
            <li Class="Core40k.DefModExtension_ForcesBodyType">
                <forcedBodyType>Male</forcedBodyType>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="ArmorHelmetMakeableBase">

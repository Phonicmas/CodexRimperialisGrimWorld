<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="ApparelMakeableBase">
        <defName>BEWH_ImperialWardenShield</defName>
        <label>Imperial Warden shield</label>
        <description>A massive shield in the style of the Lion's own. Heavier and plainer than the shield the true Lion found in Mirror-Caliban, it is built to hold a line on its own, turning aside blades and bolts alike.</description>
        <techLevel>Spacer</techLevel>
        <graphicData>
            <texPath>Things/Shields/Relics/WardenShield/WardenShield</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>BEWH_CutoutThreeColor</shaderType>
        </graphicData>
        <recipeMaker>
            <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
            <skillRequirements>
                <Crafting>18</Crafting>
            </skillRequirements>
            <recipeUsers Inherit="false">
                <li>BEWH_VulcansForge</li>
            </recipeUsers>
            <researchPrerequisites Inherit="False">
                <li>BEWH_RegaliaOfTheEmperor</li>
            </researchPrerequisites>
        </recipeMaker>
        <statBases>
            <MaxHitPoints>3000</MaxHitPoints>
            <Mass>7</Mass>
            <Flammability>0</Flammability>
            <DeteriorationRate>0</DeteriorationRate>
            <WorkToMake>80000</WorkToMake>
            <MarketValue>6000</MarketValue>
            <ArmorRating_Sharp>0.65</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
            <ArmorRating_Heat>0.6</ArmorRating_Heat>
        </statBases>
        <equippedStatOffsets>
            <MoveSpeed>-0.2</MoveSpeed>
            <ShootingAccuracyPawn>-3</ShootingAccuracyPawn>
        </equippedStatOffsets>
        <costList>
            <Plasteel>200</Plasteel>
            <Uranium>40</Uranium>
            <Gold>10</Gold>
            <ComponentSpacer>3</ComponentSpacer>
        </costList>
        <thingCategories>
            <li>ApparelArmor</li>
        </thingCategories>
        <thingSetMakerTags Inherit="False"/>
        <smeltable>false</smeltable>
        <tradeability>Sellable</tradeability>
        <apparel>
            <countsAsClothingForNudity>false</countsAsClothingForNudity>
            <careIfWornByCorpse>false</careIfWornByCorpse>
            <useDeflectMetalEffect>true</useDeflectMetalEffect>
            <bodyPartGroups>
                <li>Arms</li>
            </bodyPartGroups>
            <layers>
                <li>BEWH_Shield</li>
            </layers>
            <tags>
                <li>BEWH_LionRelic</li>
            </tags>
            <renderNodeProperties>
                <li Class="Core40k.PawnRenderNodePropertiesMultiColor">
                    <nodeClass>Core40k.PawnRenderNode_FlagEdit</nodeClass>
                    <workerClass>Core40k.PawnRenderNodeWorker_Shield</workerClass>
                    <texPath>Things/Shields/Relics/WardenShield/WardenShield</texPath>
                    <parentTagDef>Body</parentTagDef>
                    <drawData>
                        <defaultData>
                            <layer>75</layer>
                        </defaultData>
                        <dataNorth>
                            <layer>-5</layer>
                            <offset>(-0.15, 0, 0)</offset>
                        </dataNorth>
                        <dataSouth>
                            <offset>(0.25, 0, -0.2)</offset>
                        </dataSouth>
                        <dataWest>
                            <offset>(-0.25, 0, -0.2)</offset>
                        </dataWest>
                        <dataEast>
                            <layer>75</layer>
                            <offset>(0.25, 0, -0.2)</offset>
                        </dataEast>
                    </drawData>
                </li>
            </renderNodeProperties>
        </apparel>
        <comps>
            <li Class="Core40k.CompProperties_MultiColor">
                <colorMaskAmount>1</colorMaskAmount>
                <defaultPrimaryColor>(255,255,255)</defaultPrimaryColor>
                <defaultSecondaryColor>(255,255,255)</defaultSecondaryColor>
                <defaultTertiaryColor>(255,255,255)</defaultTertiaryColor>
            </li>
            <li Class="Core40k.CompProperties_AlternateTexture" />
            <li Class="Core40k.CompProperties_PhysicalShield">
                <frontArcDegrees>160</frontArcDegrees>
                <meleeBlockChance>0.9</meleeBlockChance>
                <rangedBlockChance>0.63</rangedBlockChance>
                <sideBlockFactor>0.57</sideBlockFactor>
                <shieldArmorRating>0.85</shieldArmorRating>
            </li>
        </comps>
        <modExtensions>
            <li Class="Core40k.DefModExtension_TextureFlags"/>
        </modExtensions>
    </ThingDef>
</Defs>

<?xml version="1.0" encoding="utf-8"?>
<!-- Makes the Codex Rimperialis Militarum melee weapons stuffable. Each piece keeps its old stats when made from its
     default material (its old main ingredient); other materials raise or lower armor or melee damage,
     hit points, work and flammability the vanilla way. The framework's DefModExtension_IgnoreStuffColor keeps
     the textures untinted with every material, and DefModExtension_FixedGenerationStuff makes
     generated pawns always get the default material. Off by default; switch it on in VEF's mod settings
     (toggleable patches; needs a restart). Generated by notes/CodexRimperialisGrimWorld/gen_stuffable.py. -->
<Patch>

    <Operation Class="VEF.PatchOperationToggableSequence">
        <enabled>False</enabled>
        <label>Make Codex Rimperialis Militarum melee weapons stuffable:</label>
        <operations>

            <!-- BEWH_MilitarumCombatKnife: Steel x30 (Metallic) -->
            <li Class="PatchOperationRemove">
                <xpath>Defs/ThingDef[defName="BEWH_MilitarumCombatKnife"]/costList</xpath>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_MilitarumCombatKnife"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Metallic</li>
                    </stuffCategories>
                    <costStuffCount>30</costStuffCount>
                    <defaultStuff>Steel</defaultStuff>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_MilitarumCombatKnife"]/statBases</xpath>
                <value>
                    <Flammability>2.5</Flammability>
                </value>
            </li>

            <!-- BEWH_ChainswordCadian: Steel x80 (Metallic) -->
            <li Class="PatchOperationReplace">
                <xpath>Defs/ThingDef[defName="BEWH_ChainswordCadian"]/costList</xpath>
                <value>
                    <costList Inherit="False">
                        <Plasteel>5</Plasteel>
                        <ComponentIndustrial>5</ComponentIndustrial>
                    </costList>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_ChainswordCadian"]</xpath>
                <value>
                    <stuffCategories>
                        <li>Metallic</li>
                    </stuffCategories>
                    <costStuffCount>80</costStuffCount>
                    <defaultStuff>Steel</defaultStuff>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_ChainswordCadian"]/statBases</xpath>
                <value>
                    <Flammability>2.5</Flammability>
                </value>
            </li>

            <!-- Keep the original texture colours; generated pawns get the default material -->
            <li Class="PatchOperationAdd">
                <success>Always</success>
                <xpath>Defs/ThingDef[(defName="BEWH_MilitarumCombatKnife" or defName="BEWH_ChainswordCadian") and not(modExtensions)]</xpath>
                <value>
                    <modExtensions />
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_MilitarumCombatKnife" or defName="BEWH_ChainswordCadian"]/modExtensions</xpath>
                <value>
                    <li Class="Core40k.DefModExtension_IgnoreStuffColor" />
                    <li Class="Core40k.DefModExtension_FixedGenerationStuff" />
                </value>
            </li>

        </operations>
    </Operation>

</Patch>

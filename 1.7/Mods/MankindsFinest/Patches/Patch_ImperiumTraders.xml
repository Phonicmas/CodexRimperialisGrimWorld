<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <!-- Astra Militarum apparel is Sellable (never stocked) on its own. With the Imperium faction present it becomes
         buyable and gets its own trade tag, so the Imperium traders can stock it. -->
    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[@Name="BEWH_MilitarumApparelBase"]/tradeability</xpath>
        <value>
            <tradeability>All</tradeability>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[@Name="BEWH_MilitarumApparelBase"]</xpath>
        <value>
            <tradeTags>
                <li>BEWH_MilitarumApparel</li>
            </tradeTags>
        </value>
    </Operation>

    <!-- Imperium caravans and visitors -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/TraderKindDef[defName="BEWH_ImperiumTraderCaravan"]/stockGenerators</xpath>
        <value>
            <!-- Astra Militarum weapons -->
            <li Class="StockGenerator_MarketValue">
                <tradeTag>WeaponRanged</tradeTag>
                <weaponTag>BEWH_MilitarumRanged</weaponTag>
                <countRange>2~4</countRange>
            </li>
            <li Class="StockGenerator_MarketValue">
                <tradeTag>WeaponMelee</tradeTag>
                <weaponTag>BEWH_MilitarumMelee</weaponTag>
                <countRange>1~2</countRange>
            </li>
            <!-- Astra Militarum apparel -->
            <li Class="StockGenerator_Tag">
                <tradeTag>BEWH_MilitarumApparel</tradeTag>
                <thingDefCountRange>2~4</thingDefCountRange>
                <countRange>1~2</countRange>
            </li>
        </value>
    </Operation>

    <!-- Imperium settlements -->
    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/TraderKindDef[defName="BEWH_ImperiumTraderBase"]/stockGenerators</xpath>
        <value>
            <!-- Astra Militarum weapons -->
            <li Class="StockGenerator_MarketValue">
                <tradeTag>WeaponRanged</tradeTag>
                <weaponTag>BEWH_MilitarumRanged</weaponTag>
                <countRange>4~7</countRange>
            </li>
            <li Class="StockGenerator_MarketValue">
                <tradeTag>WeaponMelee</tradeTag>
                <weaponTag>BEWH_MilitarumMelee</weaponTag>
                <countRange>2~4</countRange>
            </li>
            <!-- Astra Militarum apparel -->
            <li Class="StockGenerator_Tag">
                <tradeTag>BEWH_MilitarumApparel</tradeTag>
                <thingDefCountRange>4~7</thingDefCountRange>
                <countRange>1~3</countRange>
            </li>
        </value>
    </Operation>

</Patch>

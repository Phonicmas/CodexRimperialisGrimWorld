                        <ComponentSpacer>1</ComponentSpacer>
                    </costList>
                </value>
            </li>
            <li Class="PatchOperationAdd">
                <xpath>Defs/ThingDef[defName="BEWH_AstartesCombatShield"]</xpath>
                <value>
                    <stuffCategories>

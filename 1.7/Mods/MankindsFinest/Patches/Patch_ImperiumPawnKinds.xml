<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="Seg_Apparel_FlakArmour"]</xpath>
        <nomatch Class="PatchOperationSequence">
            <operations>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/PawnKindDef[defName="BEWH_ImperiumGuardmanPawn"]/apparelRequired</xpath>
                    <value>
                        <apparelRequired Inherit="False">
                            <li>BEWH_GuardFatigues</li>
                            <li>BEWH_CadianUniform</li>
                            <li>BEWH_CadianHeadgear</li>
                        </apparelRequired>
                    </value>
                </li>
                <li Class="PatchOperationReplace">
                    <xpath>/Defs/PawnKindDef[defName="BEWH_ImperiumGuardmanPawn"]/weaponTags</xpath>
                    <value>
                        <weaponTags>
                            <li>BEWH_MilitarumLasgun</li>
                        </weaponTags>
                    </value>
                </li>
            </operations>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/PawnKindDef[defName="BEWH_CustodesPawn"]/apparelRequired</xpath>
        <value>
            <apparelRequired>
                <li>BEWH_CustodianArmor</li>
                <li>BEWH_CustodianHelmet</li>
            </apparelRequired>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>/Defs/PawnKindDef[defName="BEWH_CustodesPawn"]/label</xpath>
        <value>
            <label>Custodian Guard</label>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/PawnKindDef[defName="BEWH_CustodesPawn"]</xpath>
        <value>
            <weaponTags Inherit="False">
                <li>BEWH_CustodesSpear</li>
            </weaponTags>
        </value>
    </Operation>

</Patch>

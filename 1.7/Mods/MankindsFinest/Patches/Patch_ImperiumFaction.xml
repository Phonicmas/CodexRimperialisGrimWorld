            <BEWH_CustodesAllarusPawn>2</BEWH_CustodesAllarusPawn>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="BEWH_ImperiumFaction"]/pawnGroupMakers/li[kindDef="Trader"]/guards</xpath>
        <value>
            <BEWH_ImperiumTempestusScionPawn>4</BEWH_ImperiumTempestusScionPawn>
        </value>

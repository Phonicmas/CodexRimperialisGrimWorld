    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="BEWH_ImperiumFaction"]/pawnGroupMakers</xpath>
        <value>
            <li>
                <kindDef>Combat</kindDef>
                <commonality>20</commonality>
                <options>
                    <BEWH_ImperiumTempestusScionPawn>10</BEWH_ImperiumTempestusScionPawn>

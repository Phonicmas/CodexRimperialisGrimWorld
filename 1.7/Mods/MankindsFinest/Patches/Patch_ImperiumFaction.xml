        <value>
            <BEWH_FirstbornAssaultMarinePawn>0.25</BEWH_FirstbornAssaultMarinePawn>
            <BEWH_FirstbornVanguardVeteranPawn>0.1</BEWH_FirstbornVanguardVeteranPawn>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="BEWH_ImperiumFaction"]/pawnGroupMakers/li[kindDef="Combat" and options/BEWH_PrimarisSpaceMarinePawn and not(options/BEWH_ImperiumGuardmanPawn) and not(options/BEWH_FirstbornPawn)]/options</xpath>
        <value>
            <BEWH_PrimarisBladeguardPawn>0.25</BEWH_PrimarisBladeguardPawn>
            <BEWH_PrimarisCaptainPawn>0.05</BEWH_PrimarisCaptainPawn>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>/Defs/FactionDef[defName="BEWH_ImperiumFaction"]/pawnGroupMakers/li[kindDef="Settlement"]/options</xpath>

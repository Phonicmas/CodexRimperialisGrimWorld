<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <ThingDef ParentName="TableGatherSpotBase">
        <defName>BEWH_ImperialTableSmall</defName>
        <label>table (1x1)</label>
        <description>A simple Imperial table. Consider yourself lucky to have one, as many in the Imperium do not. \n\nEven the simple meals of the rimworlds would be considered high-class food. Lower-class Imperial citizens live on bacterial gruel, flavored algal carboslime, and the ever-present corpse-starch.</description>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Table/Common/TableCommon1x1</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(2.65,2.65)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <uiIconScale>0.8</uiIconScale>
        <statBases>
            <MaxHitPoints>75</MaxHitPoints>
            <WorkToBuild>750</WorkToBuild>
            <Mass>5</Mass>
            <Flammability>1.0</Flammability>
            <Beauty>0.5</Beauty>
        </statBases>
        <size>(1,1)</size>
        <costStuffCount>28</costStuffCount>
        <researchPrerequisites Inherit="False">
            <li>BEWH_ImperialFurnishings</li>
        </researchPrerequisites>
    </ThingDef>

    <ThingDef ParentName="BEWH_ImperialRoyalTableBase">
        <defName>BEWH_ImperialRoyalTableSmall</defName>
        <label>imperial table royal (1x1)</label>
        <graphicData>
            <texPath>Things/Buildings/Furniture/Table/Royal/TableRoyal1x1</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2.9,2.9)</drawSize>
            <drawOffset>(0,0,0.1)</drawOffset>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <designationCategory>BEWH_RimDarkCategory</designationCategory>
        <uiIconScale>0.8</uiIconScale>
        <statBases>
            <MaxHitPoints>75</MaxHitPoints>
            <WorkToBuild>750</WorkToBuild>
            <Mass>10</Mass>
            <Flammability>1.0</Flammability>
            <Beauty>0.5</Beauty>
        </statBases>
        <size>(1,1)</size>
        <costStuffCount>28</costStuffCount>
        <rotatable>false</rotatable>
    </ThingDef>

</Defs>

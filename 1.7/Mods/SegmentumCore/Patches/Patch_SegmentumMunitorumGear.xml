<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="Seg_Apparel_FlakHelmet" or defName="Seg_Apparel_FlakArmour" or defName="Seg_Gun_MarsLasgun"]</xpath>
    </Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/Core40k.DecorationPresetDef[defName="Seg_FlakHelmetMilitarumPreset" or defName="Seg_FlakArmourMilitarumPreset"]</xpath>
    </Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/Core40k.ExtraDecorationDef[defName="Seg_Deco_FlakHelmetSkull" or defName="Seg_Deco_FlakArmourBreastplateEagle"]</xpath>
    </Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/Core40k.WeaponDecorationDef[defName="Seg_WeaponDecal_Aquila"]</xpath>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/Core40k.ColourPresetDef[@Name="Seg_ColorPreset_MarsLasgun"]/appliesTo</xpath>
        <value>
            <appliesTo>
                <li>BEWH_LasgunKantrael</li>
            </appliesTo>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BEWH_CadianUniform" or defName="BEWH_CadianHeadgear"]/apparel/tags</xpath>
        <value>
            <li>Seg_FlakArmour</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BEWH_CadianUniform" or defName="BEWH_CadianHeadgear"]/tradeTags</xpath>
        <value>
            <li>Seg_FlakArmour</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BEWH_LasgunKantrael"]/weaponTags</xpath>
        <value>
            <li>Seg_Las</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/ThingDef[defName="BEWH_LasgunKantrael"]/tradeTags</xpath>
        <match Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="BEWH_LasgunKantrael"]/tradeTags</xpath>
            <value>
                <li>Seg_Las</li>
            </value>
        </match>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/ThingDef[defName="BEWH_LasgunKantrael"]</xpath>
            <value>
                <tradeTags>
                    <li>Seg_Las</li>
                </tradeTags>
            </value>
        </nomatch>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/PawnKindDef[defName="BEWH_ImperiumGuardmanPawn"]/modExtensions/li[@Class="Core40k.DefModExtension_PawnKindCustomization" and (extraDecorations/li/key="Seg_Apparel_FlakHelmet" or extraDecorations/li/key="Seg_Apparel_FlakArmour" or extraDecorationPreset/li/key="Seg_Apparel_FlakHelmet" or extraDecorationPreset/li/key="Seg_Apparel_FlakArmour")]</xpath>
        <match Class="PatchOperationRemove">
            <xpath>Defs/PawnKindDef[defName="BEWH_ImperiumGuardmanPawn"]/modExtensions/li[@Class="Core40k.DefModExtension_PawnKindCustomization" and (extraDecorations/li/key="Seg_Apparel_FlakHelmet" or extraDecorations/li/key="Seg_Apparel_FlakArmour" or extraDecorationPreset/li/key="Seg_Apparel_FlakHelmet" or extraDecorationPreset/li/key="Seg_Apparel_FlakArmour")]</xpath>
        </match>
    </Operation>

</Patch>

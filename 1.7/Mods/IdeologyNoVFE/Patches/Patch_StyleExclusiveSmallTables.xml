<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/StyleCategoryDef[defName="BEWH_Imperialis"]/addDesignators</xpath>
        <value>
            <li>BEWH_ImperialTableSmall</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/StyleCategoryDef[defName="BEWH_ImperialNobility"]/addDesignators</xpath>
        <value>
            <li>BEWH_ImperialRoyalTableSmall</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BEWH_ImperialTableSmall"]</xpath>
        <value>
            <dominantStyleCategory>BEWH_Imperialis</dominantStyleCategory>
            <canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="BEWH_ImperialRoyalTableSmall"]</xpath>
        <value>
            <dominantStyleCategory>BEWH_ImperialNobility</dominantStyleCategory>
            <canGenerateDefaultDesignator>false</canGenerateDefaultDesignator>
        </value>
    </Operation>

</Patch>
